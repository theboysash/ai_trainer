{
  "name": "velocity-coach-ai",
  "version": "1.0.0",
  "type": "module",
  "description": "AI-powered fitness trainer with velocity-based training",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --esm --respawn --transpile-only src/index.ts",
    "build": "tsc --build",
    "build:clean": "rm -rf dist && npm run build",
    "start": "node dist/index.js",
    "compile": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "lint": "tsc --noEmit && echo 'Type checking passed!'",
    "db:setup": "node --import ./ts-node-register.js scripts/setup-database.ts",
    "db:test": "node --import ./ts-node-register.js scripts/test-connection.ts",
    "db:validate": "node --import ./ts-node-register.js scripts/validate-schema.ts",
    "test:types": "tsc --noEmit --project .",
    "serve": "npm run build && npm start"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/mongodb": "^4.0.7", 
    "@types/dotenv": "^8.2.0",
    "ts-node": "^10.9.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "mongodb": "^6.0.0",
    "dotenv": "^17.0.0",
    "@mediapipe/tasks-vision": "^0.10.0"
  }
}